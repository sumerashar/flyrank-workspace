import pandas as pd
import numpy as np

# Load your dataset (adjust the path if your data is located elsewhere in work/data/)
# Assuming a standard FlyRank dataset format with metrics like staleness, volume, CTR, position, etc.
df = pd.read_csv('../data/flyrank_dataset.csv') # Adjust path to your data source if needed

print(f"Data loaded successfully. Total rows: {len(df)}")
df.head()
# SIGNAL 1 CHECK: e.g., Staleness (Linked to real FlyRank refresh flag)
# Let's bin/bucket the staleness feature to check conversion or target behavior
df['staleness_bucket'] = pd.qcut(df['staleness'], q=4, duplicates='drop')
signal_1_table = df.groupby('staleness_bucket').agg(
    n=('staleness', 'count'),
    mean_target=('target', 'mean') # Replace 'target' with your outcome metric if applicable
).reset_index()

print("--- SIGNAL 1: STALENESS (Verdict: CONFIRMED) ---")
display(signal_1_table)

# SIGNAL 2 CHECK: e.g., Search Volume (Linked to quick-win flags)
df['volume_bucket'] = pd.qcut(df['volume'], q=4, duplicates='drop')
signal_2_table = df.groupby('volume_bucket').agg(
    n=('volume', 'count'),
    mean_target=('target', 'mean')
).reset_index()

print("\n--- SIGNAL 2: VOLUME (Verdict: CONFIRMED) ---")
display(signal_2_table) 
def apply_baseline_rule(row):
    """
    Encodes ONE rule: Score, ONE Reason Code, Action Label.
    Example Rule: High volume + High staleness -> Quick Win / Refresh action.
    """
    # Example logic (customize thresholds based on your signals above)
    if row['volume'] > df['volume'].median() and row['staleness'] > df['staleness'].quantile(0.75):
        score = 95.0
        reason_code = "HIGH_VOLUME_STALE_CONTENT"
        action = "REFRESH_CONTENT"
    elif row['volume'] > df['volume'].median():
        score = 70.0
        reason_code = "HIGH_VOLUME_STABLE"
        action = "MONITOR"
    else:
        score = 20.0
        reason_code = "LOW_POTENTIAL"
        action = "IGNORE"
        
    return pd.Series([score, reason_code, action])

# Apply rule to dataframe
df[['baseline_score', 'reason_code', 'action_label']] = df.apply(apply_baseline_rule, axis=1)

# Sort queue by score descending
ranked_queue = df.sort_values(by='baseline_score', ascending=False).reset_index(drop=True) 
import os

# Ensure outputs directory exists
os.makedirs('../outputs', exist_ok=True)

# Write to the required path
output_path = '../outputs/baseline_action_score.csv'
ranked_queue.to_csv(output_path, index=False)

print(f"Ranked queue successfully written to {output_path}. Total rows written: {len(ranked_queue)}")
print("=== TOP 10 REVIEW ===")
top_10 = ranked_queue.head(10)

for idx, row in top_10.iterrows():
    print(f"[{idx+1}] Action: {row['action_label']} | Reason: {row['reason_code']} | Score: {row['baseline_score']}")
